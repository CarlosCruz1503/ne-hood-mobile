<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de cada opción de pago: borde del color del rol cuando está seleccionada. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimaryContainer" />
            <stroke android:width="2dp" android:color="?attr/colorPrimary" />
            <corners android:radius="@dimen/radius_s" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nh_white" />
            <stroke android:width="1dp" android:color="@color/nh_line" />
            <corners android:radius="@dimen/radius_s" />
        </shape>
    </item>
</selector>
